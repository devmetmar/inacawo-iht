#!/bin/bash
# Portable InaCAWO hindcast environment — no hardcoded username.
# Shared LO / CAWO_HINDCAST_BASE / conda paths come from inacawo-deps/env.
# This file adds iht workflow paths only.
#   source $HOME/inacawo-iht/env
#
_IHT_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

_DEPS_ENV="${DEPS_BASE:-${HOME}/inacawo-deps}/env"
if [[ ! -f "${_DEPS_ENV}" ]]; then
  echo "ERROR: deps path SST not found: ${_DEPS_ENV}" >&2
  echo "       clone inacawo-deps under \$HOME (or set DEPS_BASE)." >&2
  return 1 2>/dev/null || exit 1
fi
# shellcheck disable=SC1090
source "${_DEPS_ENV}"

# -----------------
# Working directory (iht-owned)
# -----------------
export WORK_BASE="${_IHT_ENV_DIR}"
export MODEL_BASE="${HOME}/inacawo-src"
# LO_USER / LO_* / CAWO_* / CONDA_BASE / LIBDEP / COAWST_ENV: from deps env
# --------------------
# Preprocess I/O (scratch) — under CAWO_INPUT (sibling of cawo_hindcast_run/…)
# --------------------
export WPS_RUN_DIR="${CAWO_INPUT}/wps_run"
#
# Shared site inputs (read-only for most users). Canonical share is cawohdcst_ft
# (also present under cawohdcst). Override SHARED_DATA if your site differs.
export SHARED_DATA="${SHARED_DATA:-/scratch/cawohdcst_ft/data}"
export WPS_STATIC_DIR="${WPS_STATIC_DIR:-${SHARED_DATA}/static/wps/wps-4.3.1_static}"
export WRF_DIR="${WRF_DIR:-${SHARED_DATA}/static/wrf}"
export WRF_STATIC_DIR="${WRF_STATIC_DIR:-${WRF_DIR}/wrf-4.3.1_static}"
export WRF_STATIC_EXTRA_DIR="${WRF_STATIC_EXTRA_DIR:-${WRF_DIR}/extra_static}"
export GEOGRID_FILE="${GEOGRID_FILE:-${SHARED_DATA}/wps_run/geogrid_v43/geo_em.d01.nc.ID03F3}"
export GRID_DATA="${GRID_DATA:-${SHARED_DATA}/grids}"
# Per-user writable under cawo_input/
export ERA5_BASE_DIR="${CAWO_INPUT}/era5"
export GLORYS_BASE_DIR="${CAWO_INPUT}/mercator"
export ROMS_FORCING="${ROMS_FORCING:-${CAWO_INPUT}/roms_forcing}"
#
# -----------------
# Model integration
# -----------------
export CAWO_HINDCAST_RUN="${CAWO_HINDCAST_BASE}/cawo_hindcast_run"
export SWAN_STATIC="${SWAN_STATIC:-${SHARED_DATA}/cawo_hindcast_run/test_runs/cycle_2024061018_v5}"
export VARINFO="${VARINFO:-${SWAN_STATIC}}"
export GRID_SCRIP="${GRID_SCRIP:-${SHARED_DATA}/cawo_hindcast_run}"
export IN_TEMPLATES="${WORK_BASE}/hindcast_run/in_templates"
# --------------
# Postprocessing
# --------------
export CAWO_OUTPUT="${CAWO_HINDCAST_BASE}/cawo_output"
export CAWO_POST="${CAWO_HINDCAST_BASE}/cawo_post"
# --------------
# Workflow logs (under iht repo — portable / reproducible)
# --------------
export IHT_LOG_DIR="${IHT_LOG_DIR:-${WORK_BASE}/logs}"
