# CDS / cdsapi — prefer editing the auto-seeded ~/.cdsapirc from setup_env.
# Or: cp credentials/cdsapirc.dummy ~/.cdsapirc && chmod 600 ~/.cdsapirc
# Then replace the key with your personal CDS UID:API-KEY.
# Do not commit real keys.
#
url: https://cds.climate.copernicus.eu/api
key: <UID>:<API-KEY>
