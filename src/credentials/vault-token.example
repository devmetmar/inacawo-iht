# OPTIONAL — operators only (IHT_VAULT_CREDS=1).
# Training / multi-user: prefer setup_env.bash --cds-key / --cmems-user / --cmems-pass
# (see src/credentials/README.md) instead of Vault.
#
#   export IHT_VAULT_CREDS=1
#   cp src/credentials/vault-token.example src/credentials/vault-token
#   chmod 600 src/credentials/vault-token
#   # paste a real token on the line below, then: source setup_env.bash
#
# `vault-token` is gitignored — do not commit real tokens.
#
hvs.REPLACE_WITH_YOUR_VAULT_TOKEN
